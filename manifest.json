{
  "manifest_version": 3,
  "name": "Jurnal Helper by Bonsap",
  "version": "2.0",
  "description": "A Chrome extension that helps you fill out your journal automatically on Kejar.id.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.kejar.id/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/Maskot Bonsap.png",
    "32": "icons/Maskot Bonsap.png",
    "48": "icons/Maskot Bonsap.png",
    "128": "icons/Maskot Bonsap.png"
  },
  "default_icon": {
    "16": "icons/Maskot Bonsap.png",
    "32": "icons/Maskot Bonsap.png"
  }
}